rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );

      function isValidUser(data) {
        return data.uid == request.auth.uid 
            && data.email is string && data.email.size() <= 256
            && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
            && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000));
      }

      // --- Sleep Logs ---
      match /sleepLogs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSleepLog(incoming());
        allow update: if isOwner(userId) && isValidSleepLog(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['endTime', 'quality', 'notes', 'mood'])
        );
        allow delete: if isOwner(userId);

        function isValidSleepLog(data) {
          return data.userId == userId
              && data.startTime is timestamp
              && data.endTime is timestamp
              && data.startTime < data.endTime
              && data.quality is int && data.quality >= 1 && data.quality <= 5
              && (data.notes == null || (data.notes is string && data.notes.size() <= 2000))
              && (data.mood == null || (data.mood is string && data.mood.size() <= 50))
              && data.createdAt == (resource == null ? request.time : existing().createdAt);
        }
      }
    }
  }
}
